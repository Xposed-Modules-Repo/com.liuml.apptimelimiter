<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppTimeLimiter" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F8FC</item>
        <item name="android:navigationBarColor">#F7F8FC</item>
    </style>

    <style name="Theme.AppTimeLimiter.BreakPage" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#090909</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#090909</item>
        <item name="android:navigationBarColor">#090909</item>
        <item name="android:colorAccent">#FFFFFF</item>
    </style>

    <style name="Theme.AppTimeLimiter.TimePicker.Green.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#276B4E</item>
    </style>

    <style name="Theme.AppTimeLimiter.TimePicker.Green.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#91D7AE</item>
    </style>

    <style name="Theme.AppTimeLimiter.TimePicker.Blue.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#315F91</item>
    </style>

    <style name="Theme.AppTimeLimiter.TimePicker.Blue.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#A1C9FF</item>
    </style>

    <style name="Theme.AppTimeLimiter.TimePicker.Purple.Light" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#6B4EA0</item>
    </style>

    <style name="Theme.AppTimeLimiter.TimePicker.Purple.Dark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#D4BBFF</item>
    </style>
</resources>
